# TMDB API Configuration
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must never be committed.

# TMDB v4 "API Read Access Token" (NOT the v3 API key).
# Found at: TMDB account settings -> API -> API Read Access Token
# Sent as an `Authorization: Bearer <token>` header.
VITE_TMDB_TOKEN=

# Base URL for TMDB image assets. Do not include a trailing slash.
# Size suffixes (w342, w500, original) are appended by src/utils/imageUrl.ts.
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Origin the Vite dev proxy forwards to. `/tmdb/*` is rewritten to `/3/*`.
# Only change this if you need to point at a different TMDB host.
VITE_TMDB_API_ORIGIN=https://api.themoviedb.org
