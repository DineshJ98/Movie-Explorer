# TMDB API Configuration
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must never be committed.

# --- Development only -------------------------------------------------------
# In development the Vite dev proxy talks to TMDB directly, so the token has to
# be reachable from the browser process. `VITE_`-prefixed vars are inlined into
# the bundle, so this token is public in `pnpm dev` too. That is acceptable for a
# read-only catalogue key, and it is the only reason this file exists.

# TMDB v4 "API Read Access Token" (NOT the v3 API key).
# Found at: TMDB account settings -> API -> API Read Access Token
# Sent as an `Authorization: Bearer <token>` header.
VITE_TMDB_TOKEN=

# --- Production -------------------------------------------------------------
# Production MUST NOT set VITE_TMDB_TOKEN. Anything VITE_-prefixed is inlined
# into the public bundle, and vite.config.ts fails the production build outright
# if it is present. In production `api/tmdb/[...path].js` injects the token
# server-side from this variable, so the browser never receives it.

# Same v4 read access token, but server-only (no VITE_ prefix).
# Set this in the Vercel project's environment variables.
# Unprefixed vars are not exposed to the client bundle.
TMDB_TOKEN=

# Base URL for TMDB image assets. Do not include a trailing slash.
# Size suffixes (w342, w500, original) are appended by src/utils/imageUrl.ts.
# Falls back to https://image.tmdb.org/t/p when unset, so a missing value costs
# broken images rather than a blank page.
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Origin the Vite dev proxy forwards to. `/tmdb/*` is rewritten to `/3/*`.
# Only change this if you need to point at a different TMDB host.
# The production function reads its own optional `TMDB_API_ORIGIN`.
VITE_TMDB_API_ORIGIN=https://api.themoviedb.org
