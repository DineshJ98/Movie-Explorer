# TMDB API Configuration
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must never be committed.

# --- The TMDB token ---------------------------------------------------------
# ONE variable, used by BOTH environments. It has no `VITE_` prefix, so Vite never
# inlines it into the bundle and it is unreachable from the browser.
#
#   development -> the Vite dev proxy at /api/tmdb reads it and adds the
#                  Authorization header itself
#   production  -> api/tmdb/[...path].js reads it and does the same
#
# This is deliberate. Development and production used to differ: dev read a
# VITE_-prefixed token from the browser and production read TMDB_TOKEN on the
# server. Because `.env.local` is loaded in every mode, the variable dev *needed*
# was the same one vite.config.ts refused to let a production build see -- so
# fixing one environment broke the other.

# TMDB v4 "API Read Access Token" (NOT the v3 API key).
# Found at: TMDB account settings -> API -> API Read Access Token
# Sent as an `Authorization: Bearer <token>` header by the proxy, never by the client.
# Local: put it here. Vercel: set it as TMDB_TOKEN for the environment you deploy.
TMDB_TOKEN=

# Never set a VITE_TMDB_TOKEN. If one is present, vite.config.ts fails the
# production build on purpose, because it would end up in the public bundle.

# Base URL for TMDB image assets. Do not include a trailing slash.
# Size suffixes (w342, w500, original) are appended by src/utils/imageUrl.ts.
# Falls back to https://image.tmdb.org/t/p when unset, so a missing value costs
# broken images rather than a blank page.
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Origin the Vite dev proxy forwards to. `/api/tmdb/*` is rewritten to `/3/*`.
# Only change this if you need to point at a different TMDB host.
VITE_TMDB_API_ORIGIN=https://api.themoviedb.org

# --- Local HTTPS (needed for TMDB sign-in in development) --------------------
# TMDB's edge returns 403 when an approval request carries a `redirect_to` that
# points at `localhost`. Their forum staff confirm the block and suggest using "a
# local resolvable domain" instead. Two things therefore have to be true at once:
# the hostname must not be `localhost`, and TMDB asks for HTTPS.
#
# `*.localtest.me` resolves to loopback through public DNS, so no `/etc/hosts`
# edit and no sudo are needed just to resolve it. `localtest.me` is a public
# domain, so mkcert can issue a certificate that the browser trusts.
#
# One-time setup:
#   # 1. install mkcert, then trust its CA once (this step needs sudo)
#   mkcert -install
#   # 2. issue a cert/key pair
#   mkcert -cert-file ~/.local/share/movie-explorer-dev/dev-cert.pem \
#          -key-file  ~/.local/share/movie-explorer-dev/dev-key.pem \
#          movie-explorer.localtest.me localhost 127.0.0.1 ::1
#
# Then set the four paths below in `.env.local`. All are unprefixed, so they are
# read by vite.config.ts in Node and never inlined into the client bundle.
#
# Leave them unset and `pnpm dev` falls back to plain HTTP on localhost, which is
# fine for everything except TMDB sign-in.
#
# The origin you type in the browser. Vite prints this URL on startup because its
# default `http://localhost` hint is the one TMDB rejects.
DEV_HOST=movie-explorer.localtest.me
# Address Vite binds to. Loopback only — `true` would expose the dev server to
# your LAN. Kept separate from DEV_HOST so dev works offline.
DEV_BIND_HOST=127.0.0.1
DEV_HTTPS_CERT=
DEV_HTTPS_KEY=
